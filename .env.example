# Credentials for the NorthStar fetch client.
# Copy to .env and fill in. Never commit .env.

# NLR Developer Network (formerly NREL) - https://developer.nlr.gov/signup/
NREL_API_KEY=
NREL_EMAIL=

# ERCOT Public API - https://developer.ercot.com/
#
# THREE values are needed, not two. The subscription key is separate from the
# login: register at developer.ercot.com, then subscribe to the "Public API"
# product and copy the primary key from your profile page.
#
# A blank value here is rejected by `require()` before any request is made.
# It previously passed validation and surfaced as an opaque 401 minutes into
# a fetch.
ERCOT_USERNAME=
ERCOT_PASSWORD=
ERCOT_SUBSCRIPTION_KEY=

# EIA API v2 - https://www.eia.gov/opendata/
EIA_API_KEY=
